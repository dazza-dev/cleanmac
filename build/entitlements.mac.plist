<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 needs both of these under the Hardened Runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required so Electron can load its own unsigned helper frameworks. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The app sandbox is intentionally absent: a sandboxed process cannot read
       other applications' support directories, which is the whole job. -->
</dict>
</plist>
